# ===== Telegram配置 =====
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ===== AI配置 =====
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 管理员配置 =====
# 管理员ID（支持多个ID，用逗号分隔，ID为纯数字）
# 未配置时所有管理命令与 WebUI 管理权限将被拒绝（fail-closed），请务必配置
REPORT_ADMIN_IDS=your_admin_id_here,another_admin_id_here

# ===== 语言配置 =====
# 界面语言（zh-CN - 简体中文，en-US - 英语）
LANGUAGE=zh-CN

# ===== 日志配置 =====
# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO
# 是否启用文件日志（true/false）
LOG_TO_FILE=true
# 日志文件路径
LOG_FILE_PATH=logs/sakura-bot.log
# 单个日志文件最大大小（字节，默认10485760 = 10MB）
LOG_FILE_MAX_SIZE=10485760
# 保留的日志备份文件数量（0-20）
LOG_FILE_BACKUP_COUNT=5
# 是否启用控制台日志（true/false）
LOG_TO_CONSOLE=true
# 是否启用彩色日志输出（仅控制台，true/false）
LOG_COLORIZE=true

# ===== 投票功能配置 =====
# 是否启用投票功能（默认开启）
ENABLE_POLL=True
# 投票是否公开投票者（True=公开，False=匿名，默认公开）
POLL_PUBLIC_VOTERS=True

# ===== 数据库配置 =====
# 数据库类型（仅支持MySQL）
DATABASE_TYPE=mysql

# MySQL数据库配置（必需）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sakura_bot
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=sakura_bot_db
MYSQL_CHARSET=utf8mb4

# MySQL连接池配置
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30

# ===== 问答Bot配置 =====
# 问答Bot的Token（从@BotFather获取，必须与主Bot不同）
QA_BOT_TOKEN=your_qa_bot_token_here

# 问答Bot的用户名（例如：@my_qa_bot，用于生成跳转链接）
# 如果不设置，将从 Bot API 自动获取
QA_BOT_USERNAME=your_qa_bot_username_here

# 是否启用问答Bot（True/False）
QA_BOT_ENABLED=True

# ===== UserBot 配置 =====
# UserBot 使用您的真实 Telegram 账号，具有更高的权限
# 可以访问私有频道，抓取消息更稳定

# 是否启用 UserBot（true/false）
USERBOT_ENABLED=true

# UserBot 手机号（国际格式，例如：+8613800138000）
# 首次启用时需要输入验证码进行登录
USERBOT_PHONE_NUMBER=

# UserBot Session 文件路径（自动保存，下次启动自动登录）
USERBOT_SESSION_PATH=data/sessions/user_session

# UserBot 降级策略（true/false）
# 如果 UserBot 不可用，是否降级到临时会话方式
USERBOT_FALLBACK_TO_BOT=false

# 问答Bot使用限制配置
# 每个用户每日限额（默认3次）
QA_BOT_USER_LIMIT=3

# ===== WebUI 管理界面配置 =====
# 是否启用 WebUI 管理界面（true/false）
WEBUI_ENABLED=true
# WebUI 监听地址
WEBUI_HOST=0.0.0.0
# WebUI 监听端口
WEBUI_PORT=8080
# 是否启用开发模式（允许使用 dev 免认证登录，仅用于本地调试）
WEBUI_DEV_MODE=false

# 每日总限额（默认200次）
QA_BOT_DAILY_LIMIT=200

# 问答Bot人格配置（可选）
# 方式1：直接设置人格文本
# QA_BOT_PERSONA=你是一个专业的技术顾问...
#
# 方式2：指向自定义人格文件
# QA_BOT_PERSONA=data/custom_persona.txt
#
# 如果不设置，将使用 data/qa_persona.txt 中的默认人格

# ===== 向量数据库配置 (v3.0.0) =====
# Embedding API配置
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Reranker API配置
RERANKER_API_KEY=your_reranker_api_key_here
RERANKER_API_BASE=https://api.siliconflow.cn/v1/rerank
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=20
RERANKER_FINAL=5

# 向量数据库存储路径
VECTOR_DB_PATH=data/vectors
